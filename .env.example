# Copy this file to .env.local and fill in your real value.
# .env.local is ignored by git, so it never reaches GitHub.
#
# Neon dashboard > your project > Connect > copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key for meal analysis. Server-side only: never give it a
# NEXT_PUBLIC_ name, and never commit the real value.
ANTHROPIC_API_KEY="your-key-here"

# Stripe, for the Premium subscription. Use a test mode restricted key (rk_test_...) until going live.
# All three are server-side only: never give them a NEXT_PUBLIC_ name.
STRIPE_SECRET_KEY="rk_test_your-key-here"
STRIPE_WEBHOOK_SECRET="whsec_your-secret-here"
STRIPE_PRICE_ID="price_your-price-id-here"

# Optional: model used for meal analysis. Defaults to claude-haiku-5-5.
# AI_MODEL="claude-haiku-5-5"
